// Windows file-version resource - what Explorer's Properties > Details tab (and the
// context menu's own "Details" entry) reads for FileDescription/FileVersion/
// ProductVersion/CompanyName/Language. Numbers come from core/version_defs.h (see its own
// comment for why that's a plain macro header rather than core/version.h's real C++
// constants) so this can never drift from the version the app itself reports at runtime.
#include "core/version_defs.h"
#include "resource.h"

// Rift's own app icon - what Explorer shows for the .exe itself (and any shortcut to
// it), before the process is even running. The lowest-numbered ICON resource in the file
// is what Explorer treats as the default, and this is the only one, so IDI_APP_ICON's
// specific value doesn't matter beyond matching window.cpp's own LoadIconW call, which
// loads this same resource for the live window/taskbar/Alt+Tab icon while running.
IDI_APP_ICON ICON "../resources/Rift.ico"

1 VERSIONINFO
 FILEVERSION RIFT_VERSION_MAJOR,RIFT_VERSION_MINOR,RIFT_VERSION_PATCH,0
 PRODUCTVERSION RIFT_VERSION_MAJOR,RIFT_VERSION_MINOR,RIFT_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0: langID 0x0409 (English - United States), charset 1200 (Unicode) -
        // matched by the VarFileInfo Translation block below, which is what actually
        // tells Explorer which StringFileInfo block to read.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Rift"
            VALUE "FileDescription", "A Modern Riot Games Account Manager"
            VALUE "FileVersion", RIFT_VERSION_STRING
            VALUE "InternalName", "Rift"
            VALUE "OriginalFilename", "Rift.exe"
            VALUE "ProductName", "Rift"
            VALUE "ProductVersion", RIFT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
